{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "error",
    "perf": "warn",
    "suspicious": "error"
  },
  "ignorePatterns": [".revisium-actions/**", "coverage/**", "dist/**", "node_modules/**"],
  "options": {
    "typeAware": true,
    "typeCheck": true
  },
  "plugins": ["import", "typescript", "vitest"],
  "rules": {
    "curly": ["error", "all"],
    "max-classes-per-file": ["error", 1],
    "import/extensions": [
      "error",
      "ignorePackages",
      { "checkDynamicImport": true, "checkTypeImports": true, "pattern": { "js": "always" } }
    ],
    "max-lines-per-function": "off",
    "no-restricted-imports": [
      "error",
      {
        "patterns": [
          {
            "regex": "^@revisium/revo-run(?:/|$)",
            "message": "Pipeline is a dependency of run and must never import run."
          },
          {
            "regex": "^(?:@revisium/(?:revo-(?:agent-runtime|scripts)|orchestrator)(?:/|$)|orchestrator(?:/|$)|@prisma/client(?:/|$)|prisma(?:/|$)|@dbos-inc/|dbos(?:/|$)|pg-boss(?:/|$)|graphile-worker(?:/|$)|@nestjs/|nestjs(?:/|$)|graphql(?:/|$)|@modelcontextprotocol/)",
            "message": "Run, execution, persistence, queue, and host-framework packages are outside revo-pipeline."
          }
        ]
      }
    ],
    "typescript/no-explicit-any": "error",
    "typescript/no-floating-promises": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-unsafe-argument": "error",
    "typescript/no-unsafe-assignment": "error",
    "typescript/no-unsafe-call": "error",
    "typescript/no-unsafe-member-access": "error",
    "typescript/no-unsafe-return": "error",
    "typescript/switch-exhaustiveness-check": "error",
    "vitest/no-disabled-tests": "error",
    "vitest/no-focused-tests": "error"
  },
  "overrides": [
    {
      "files": ["**/src/**/*.ts"],
      "rules": {
        "max-lines-per-function": [
          "error",
          { "max": 80, "skipBlankLines": false, "skipComments": false, "IIFEs": true }
        ]
      }
    },
    {
      "files": ["**/test/**/*.ts"],
      "rules": {
        "no-restricted-imports": [
          "error",
          {
            "patterns": [
              {
                "regex": "^@revisium/revo-run(?:/|$)",
                "message": "Pipeline is a dependency of run and must never import run."
              },
              {
                "regex": "^(?:@revisium/(?:revo-(?:agent-runtime|scripts)|orchestrator)(?:/|$)|orchestrator(?:/|$)|@prisma/client(?:/|$)|prisma(?:/|$)|@dbos-inc/|dbos(?:/|$)|pg-boss(?:/|$)|graphile-worker(?:/|$)|@nestjs/|nestjs(?:/|$)|graphql(?:/|$)|@modelcontextprotocol/)",
                "message": "Run, execution, persistence, queue, and host-framework packages are outside revo-pipeline."
              },
              {
                "group": [
                  "**/src/spec/**",
                  "**/src/policy/**",
                  "**/src/errors/**",
                  "**/src/definition/**",
                  "**/src/graph/**",
                  "**/src/transition/**",
                  "!**/src/spec/index.js",
                  "!**/src/policy/index.js",
                  "!**/src/errors/index.js",
                  "!**/src/definition/index.js",
                  "!**/src/graph/index.js",
                  "!**/src/transition/index.js"
                ],
                "message": "Tests consume production layers through curated barrels."
              }
            ]
          }
        ]
      }
    }
  ]
}
