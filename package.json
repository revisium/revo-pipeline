{
  "name": "@revisium/revo-pipeline",
  "version": "0.2.0-alpha.2",
  "description": "Under-development portable pipeline language, compiler, and pure kernel for Revo.",
  "homepage": "https://github.com/revisium/revo-pipeline#readme",
  "bugs": {
    "url": "https://github.com/revisium/revo-pipeline/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revisium/revo-pipeline.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./kernel": {
      "types": "./dist/kernel/public.d.ts",
      "import": "./dist/kernel/public.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "tag": "alpha"
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "rm -rf dist && tsc -p tsconfig.build.json && find dist -type d -exec chmod 755 {} + && find dist -type f -exec chmod 644 {} +",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test": "vitest run",
    "test:cov": "vitest run --coverage",
    "test:architecture": "depcruise --config .dependency-cruiser.cjs src test",
    "verify:architecture": "pnpm run test:architecture",
    "verify:package": "node scripts/verify-package.mjs",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run test:cov && pnpm run verify:architecture && pnpm run verify:package",
    "sonar:local": "bash scripts/sonar-local.sh",
    "sonar:issues:local": "bash scripts/sonar-issues-local.sh",
    "ci:local:sonar": "bash scripts/ci-local-sonar.sh",
    "prepack": "pnpm run build"
  },
  "dependencies": {
    "canonicalize": "4.0.0",
    "typebox": "1.3.10"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.9",
    "dependency-cruiser": "18.1.1",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "publint": "0.3.21",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "packageManager": "pnpm@11.13.0"
}
