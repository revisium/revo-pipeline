{
  "name": "@revisium/revo-pipeline",
  "version": "0.0.0",
  "description": "Portable pipeline definition, compilation, and transition semantics for Revo.",
  "homepage": "https://github.com/revisium/revo-pipeline#readme",
  "bugs": {
    "url": "https://github.com/revisium/revo-pipeline/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/revisium/revo-pipeline.git"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "clean": "rm -rf dist coverage",
    "build": "rm -rf dist && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "oxlint --type-aware --type-check --deny-warnings --report-unused-disable-directives .",
    "format": "oxfmt --write .",
    "format:check": "oxfmt --check .",
    "test:unit": "vitest run --config vitest.config.ts",
    "test:harness": "vitest run --config vitest.harness.config.ts",
    "test:package": "vitest run --config vitest.package.config.ts",
    "test:architecture": "depcruise --config .dependency-cruiser.cjs src test",
    "test:characterization": "vitest run --config vitest.characterization.config.ts",
    "test": "pnpm run test:unit && pnpm run test:harness && pnpm run test:package && pnpm run test:characterization",
    "test:cov": "vitest run --config vitest.coverage.config.ts --coverage",
    "verify:test-routing": "node --import tsx scripts/verify-test-routing.ts",
    "verify:product-coverage": "node --import tsx scripts/verify-product-coverage.ts",
    "verify:characterization": "node --import tsx scripts/verify-characterization.ts",
    "verify:architecture": "pnpm run test:architecture",
    "verify:package": "pnpm run build && node --import tsx scripts/verify-package.ts",
    "verify": "pnpm run format:check && pnpm run typecheck && pnpm run lint && pnpm run verify:test-routing && pnpm run test:harness && pnpm run test:cov && pnpm run verify:product-coverage && pnpm run verify:characterization && pnpm run verify:architecture && pnpm run verify:package",
    "sonar:local": "bash scripts/sonar-local.sh",
    "sonar:issues:local": "bash scripts/sonar-issues-local.sh",
    "ci:local:sonar": "bash scripts/ci-local-sonar.sh",
    "prepack": "pnpm run build"
  },
  "devDependencies": {
    "@arethetypeswrong/cli": "0.18.5",
    "@types/node": "24.13.3",
    "@vitest/coverage-v8": "4.1.9",
    "dependency-cruiser": "18.1.1",
    "oxfmt": "0.58.0",
    "oxlint": "1.73.0",
    "oxlint-tsgolint": "0.24.0",
    "publint": "0.3.21",
    "tsx": "4.23.1",
    "typescript": "7.0.2",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=24.11.1 <25"
  },
  "packageManager": "pnpm@11.13.0"
}
